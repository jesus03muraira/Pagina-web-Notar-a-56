    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: 2px;
  }

  .sidebar-widget h3 {
    font-family: var(--font-serif);
    color: var(--color-navy);
    font-size: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
