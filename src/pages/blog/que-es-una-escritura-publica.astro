    color: var(--color-text);
    line-height: 1.85;
    margin-bottom: 2rem;
    border-left: 3px solid var(--color-gold);
    padding-left: 1.25rem;
  }

  .article-body h2 {
    font-family: var(--font-serif);
    color: var(--color-navy);
    font-size: 1.3rem;
    margin: 2rem 0 0.75rem;
  }

  .article-body p {
