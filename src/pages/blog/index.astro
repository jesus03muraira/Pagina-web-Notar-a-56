---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = [
  {
    slug: 'que-es-una-escritura-publica',
    titulo: '¿Qué es una escritura pública y para qué sirve?',
    fecha: '2 de mayo, 2025',
    categoria: 'Derecho Inmobiliario',
    resumen:
      'La escritura pública es el documento más importante en cualquier transacción inmobiliaria. En este artículo explicamos qué es, cuándo se necesita y cuáles son sus efectos legales.',
  },
  {
    slug: 'como-hacer-un-testamento',
    titulo: 'Cómo hacer un testamento: guía paso a paso',
    fecha: '18 de abril, 2025',
    categoria: 'Sucesiones',
    resumen:
      'Muchas personas posponen hacer su testamento por desconocimiento del proceso. Aquí te explicamos los tipos de testamento, los requisitos y por qué es importante hacerlo hoy.',
  },
  {
    slug: 'poder-notarial-tipos',
    titulo: 'Tipos de poder notarial: ¿cuál necesito?',
    fecha: '5 de abril, 2025',
    categoria: 'Poderes',
    resumen:
      'El poder notarial es un documento que permite a otra persona actuar en tu nombre. Existen varios tipos con diferentes alcances. Te ayudamos a elegir el correcto para tu situación.',
  },
  {
    slug: 'apostilla-documentos-extranjero',
    titulo: 'Apostilla de documentos: todo lo que debes saber',
    fecha: '22 de marzo, 2025',
    categoria: 'Trámites Internacionales',
    resumen:
      'Si necesitas usar un documento mexicano en el extranjero, probablemente necesites una apostilla. Explicamos el proceso, los costos y los tiempos de tramitación.',
  },
];
---

<Layout title="Blog" description="Artículos y guías sobre derecho notarial, trámites y consejos legales de la Notaría Pública No. 56.">
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <p class="section-subtitle">Recursos y orientación</p>
      <h1>Blog del Notario</h1>
      <p class="page-hero-desc">
        Artículos escritos por nuestro equipo para orientarte en tus trámites legales
        y mantenerte informado sobre el derecho notarial.
      </p>
    </div>
  </section>

  <!-- Hero photo -->
  <div class="blog-hero-img">
    <img src={`${base}/images/blog.jpg`} alt="Blog del Notario" />
  </div>

  <!-- Posts -->
  <section class="section blog-section">
    <div class="container blog-layout">
      <div class="posts-list">
        {posts.map(post => (
          <article class="post-card">
            <div class="post-meta">
              <span class="post-categoria">{post.categoria}</span>
              <span class="post-fecha">{post.fecha}</span>
            </div>
            <h2 class="post-titulo">
              <a href={`/blog/${post.slug}`}>{post.titulo}</a>
            </h2>
            <p class="post-resumen">{post.resumen}</p>
            <a href={`/blog/${post.slug}`} class="post-link">
              Leer artículo <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <aside class="blog-sidebar">
        <div class="sidebar-widget">
          <h3>Categorías</h3>
          <ul>
            <li><a href="#">Derecho Inmobiliario</a></li>
            <li><a href="#">Sucesiones</a></li>
            <li><a href="#">Poderes</a></li>
            <li><a href="#">Trámites Internacionales</a></li>
            <li><a href="#">Derecho Corporativo</a></li>
          </ul>
        </div>

        <div class="sidebar-widget sidebar-cta">
          <h3>¿Tienes una pregunta?</h3>
          <p>
            Nuestro equipo puede orientarte antes de comenzar cualquier trámite.
          </p>
          <a href="/contacto" class="btn btn-primary" style="width:100%; text-align:center;">
            Contactar
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: var(--color-navy);
    padding: 4rem 0 3rem;
    border-bottom: 3px solid var(--color-gold);
  }

  .page-hero h1 {
    font-family: var(--font-serif);
    color: var(--color-white);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 0.75rem;
  }

  .page-hero-desc {
    color: rgba(255,255,255,0.7);
    max-width: 520px;
    line-height: 1.75;
  }

  .page-hero .section-subtitle {
    margin-bottom: 0.5rem;
  }

  .blog-hero-img {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    line-height: 0;
  }

  .blog-hero-img img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 700px) {
    .blog-hero-img img { height: 260px; }
  }

  .blog-section {
    background: var(--color-cream);
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-gold);
    padding: 2rem;
    border-radius: 2px;
    transition: box-shadow 0.2s;
  }

  .post-card:hover {
    box-shadow: 0 4px 16px rgba(26,46,90,0.09);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .post-categoria {
    background: var(--color-gold-pale);
    color: var(--color-navy);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }

  .post-fecha {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .post-titulo {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .post-titulo a:hover {
    color: var(--color-gold);
  }

  .post-resumen {
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .post-link {
    color: var(--color-navy);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }

  .post-link:hover {
    color: var(--color-gold);
  }

  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 5.5rem;
  }

  .sidebar-widget {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: 2px;
  }

  .sidebar-widget h3 {
    font-family: var(--font-serif);
    color: var(--color-navy);
    font-size: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-gold);
  }

  .sidebar-widget ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-widget a {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .sidebar-widget a:hover {
    color: var(--color-gold);
  }

  .sidebar-cta {
    background: var(--color-navy);
  }

  .sidebar-cta h3 {
    color: var(--color-gold);
    border-bottom-color: rgba(201,162,39,0.4);
  }

  .sidebar-cta p {
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .blog-layout {
      grid-template-columns: 1fr;
    }
    .blog-sidebar {
      position: static;
    }
  }
</style>
