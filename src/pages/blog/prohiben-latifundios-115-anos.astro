---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const post = {
  titulo: 'Prohíben los latifundios hace 115 años',
  fecha: '20 de noviembre, 2024',
  categoria: 'Derecho Agrario',
  autor: 'Notaría Pública No. 56',
};
---

<Layout title={post.titulo} description="El origen constitucional de la prohibición de los latifundios y los límites que establece el artículo 27 para la pequeña propiedad en México.">
  <section class="page-hero">
    <div class="container">
      <a href={`${base}/blog`} class="back-link">← Volver al Blog</a>
      <p class="post-categoria">{post.categoria}</p>
      <h1>{post.titulo}</h1>
      <div class="post-byline">
        <span>{post.autor}</span>
        <span>·</span>
        <span>{post.fecha}</span>
      </div>
    </div>
  </section>

  <div class="article-img">
    <img src={`${base}/images/blog1.jpg`} alt="Prohíben los latifundios hace 115 años" />
  </div>
</Layout>

<style>
  .page-hero {
    background: var(--color-navy);
    padding: 8rem 0 3rem;
    border-bottom: 3px solid var(--color-gold);
  }

  .back-link {
    color: var(--color-gold);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 1.25rem;
    transition: opacity 0.2s;
  }

  .back-link:hover { opacity: 0.75; }

  .post-categoria {
    background: var(--color-gold-pale);
    color: var(--color-navy);
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    font-family: var(--font-serif);
    color: var(--color-white);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    max-width: 680px;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .post-byline {
    display: flex;
    gap: 0.5rem;
    color: rgba(255,255,255,0.55);
    font-size: 0.85rem;
  }

  .article-img {
    width: 100%;
    line-height: 0;
  }

  .article-img img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
