---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const servicios = [
  { id: 'compraventa',    label: 'Compraventa' },
  { id: 'donacion',       label: 'Donación' },
  { id: 'hipoteca',       label: 'Constitución de Hipoteca' },
  { id: 'escrituracion',  label: 'Escrituración' },
  { id: 'dacion',         label: 'Dación en Pago' },
  { id: 'fusion',         label: 'Fusión de Inmuebles' },
  { id: 'subdivision',    label: 'Subdivisión' },
  { id: 'usufructo',      label: 'Usufructo' },
  { id: 'condominio',     label: 'Régimen en Condominio' },
];
---

<Layout title="Inmobiliarios" description="Trámites notariales relacionados con bienes raíces, transmisión de propiedad y derechos reales sobre inmuebles.">

  <!-- Hero -->
  <section class="ramo-hero">
    <div class="container">
      <a href={`${base}/#servicios`} class="ramo-back">← Servicios</a>
      <h1>Inmobiliarios</h1>
      <p class="ramo-intro">Trámites notariales relacionados con bienes raíces, transmisión de propiedad y derechos reales sobre inmuebles.</p>
    </div>
  </section>

  <!-- Foto -->
  <div class="ramo-imagen">
    <img src={`${base}/images/inmob.jpg`} alt="Servicios Inmobiliarios" />
  </div>

  <!-- Barra de navegación sticky -->
  <nav class="servicio-nav" id="servicioNav">
    <div class="servicio-nav-inner">
      {servicios.map(s => (
        <a href={`#${s.id}`} class="nav-pill" data-target={s.id}>{s.label}</a>
      ))}
    </div>
  </nav>

  <!-- Secciones de servicios -->
  <div class="servicios-contenido">

    <section class="servicio-seccion" id="compraventa">
      <div class="container">
        <h2>Compraventa de Inmuebles</h2>
        <p class="servicio-desc">Formalizamos jurídicamente la transmisión de propiedad de bienes raíces entre particulares o con personas morales, garantizando la certeza legal de la operación ante el Registro Público de la Propiedad.</p>
        <div class="requisitos-grid">
          <div class="req-bloque">
            <h4>Vendedor</h4>
            <ol>
              <li>Título de Propiedad de él o los vendedores.</li>
              <li>Recibo del Impuesto Predial al corriente en sus pagos.</li>
              <li>Acta de Matrimonio de los vendedores para el caso de que hayan adquirido el inmueble durante el matrimonio.</li>
              <li>Último recibo pagado del servicio de agua y drenaje, y si es casa habitación, recibos del servicio de energía eléctrica o de telefonía fija.</li>
              <li>Identificación oficial de él o de los vendedores (Credencial del INE o pasaporte vigente).</li>
            </ol>
          </div>
          <div class="req-bloque">
            <h4>Comprador</h4>
            <ol>
              <li>Identificación oficial de él o de los compradores (Credencial del INE o pasaporte vigente).</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="servicio-seccion servicio-seccion--alt" id="donacion">
      <div class="container">
        <h2>Donación de Inmuebles</h2>
        <p class="servicio-desc">Protocolo notarial para la transmisión gratuita de bienes raíces entre personas, con plena validez legal y registro ante las autoridades correspondientes.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion" id="hipoteca">
      <div class="container">
        <h2>Constitución de Hipoteca</h2>
        <p class="servicio-desc">Instrumentación notarial del gravamen hipotecario sobre bienes inmuebles como garantía de obligaciones crediticias, con inscripción en el Registro Público de la Propiedad.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion servicio-seccion--alt" id="escrituracion">
      <div class="container">
        <h2>Escrituración de Propiedad</h2>
        <p class="servicio-desc">Elaboración del instrumento notarial que acredita la propiedad de un inmueble, con todos los efectos legales frente a terceros mediante su inscripción registral.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion" id="dacion">
      <div class="container">
        <h2>Dación en Pago</h2>
        <p class="servicio-desc">Formalización notarial del acuerdo mediante el cual un deudor transmite un bien inmueble a su acreedor como forma de extinción de una obligación de pago.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion servicio-seccion--alt" id="fusion">
      <div class="container">
        <h2>Fusión de Inmuebles</h2>
        <p class="servicio-desc">Unificación jurídica de dos o más predios colindantes en un solo inmueble, con la correspondiente modificación registral y catastral ante las autoridades competentes.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion" id="subdivision">
      <div class="container">
        <h2>Subdivisión de Inmuebles</h2>
        <p class="servicio-desc">División notarial y registral de un inmueble en dos o más fracciones independientes, con asignación de nuevas claves catastrales y registro de cada fracción resultante.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion servicio-seccion--alt" id="usufructo">
      <div class="container">
        <h2>Constitución de Usufructo Vitalicio o Temporal</h2>
        <p class="servicio-desc">Instrumentación del derecho real de uso y disfrute de un inmueble ajeno, ya sea de forma vitalicia o por un periodo determinado, reservando la nuda propiedad al propietario.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

    <section class="servicio-seccion" id="condominio">
      <div class="container">
        <h2>Constitución de Régimen de Propiedad en Condominio</h2>
        <p class="servicio-desc">Establecimiento del régimen jurídico que regula la propiedad exclusiva de unidades privativas y la copropiedad de áreas comunes en edificios o conjuntos habitacionales o comerciales.</p>
        <p class="servicio-proximamente">Consulta los requisitos específicos directamente con nuestro equipo.</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Solicitar información</a>
      </div>
    </section>

  </div>

  <!-- CTA -->
  <div class="ramo-cta-final">
    <div class="container ramo-cta-inner">
      <p>¿Necesitas asesoría sobre alguno de estos trámites?</p>
      <a href={`${base}/contacto`} class="btn btn-primary">Agendar consulta</a>
    </div>
  </div>

</Layout>

<style>
  /* ── Hero ── */
  .ramo-hero {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 7rem 0 4.5rem;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-back {
    color: var(--color-gold-pale);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .ramo-back:hover { color: var(--color-white); }

  .ramo-hero h1 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: 0.04em;
    margin: 0.4rem 0 1.5rem;
  }

  .ramo-intro {
    max-width: 640px;
    color: rgba(255,255,255,0.78);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── Foto ── */
  .ramo-imagen {
    width: 100%;
    line-height: 0;
  }
  .ramo-imagen img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Nav sticky ── */
  .servicio-nav {
    position: relative;
    z-index: 10;
    background: var(--color-navy);
    border-bottom: 2px solid var(--color-gold);
    box-shadow: 0 2px 12px rgba(8,20,40,0.18);
  }

  .servicio-nav-inner {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 0;
    padding: 0 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .servicio-nav-inner::-webkit-scrollbar { display: none; }

  .nav-pill {
    flex-shrink: 0;
    padding: 0.9rem 1.2rem;
    color: rgba(255,255,255,0.6);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
  }

  .nav-pill:hover {
    color: var(--color-white);
  }

  .nav-pill.active {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }

  /* ── Secciones ── */
  .servicios-contenido {
    font-family: var(--font-display);
    font-weight: 300;
  }

  .servicio-seccion {
    padding: 4rem 0;
    background: var(--color-white);
  }

  .servicio-seccion--alt {
    background: var(--color-cream);
  }

  .servicio-seccion h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    color: var(--color-navy);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-gold);
    display: inline-block;
    letter-spacing: 0.02em;
  }

  .servicio-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
    max-width: 720px;
    margin-bottom: 2rem;
  }

  .servicio-proximamente {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  /* ── Requisitos Compraventa ── */
  .requisitos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    max-width: 820px;
    margin-top: 2rem;
  }

  .req-bloque h4 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(158,124,63,0.3);
  }

  .req-bloque ol {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .req-bloque li {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  /* ── CTA final ── */
  .ramo-cta-final {
    background: var(--color-navy);
    border-top: 3px solid var(--color-gold);
    padding: 3rem 0;
  }

  .ramo-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .ramo-cta-inner p {
    color: rgba(255,255,255,0.8);
    font-family: var(--font-display);
    font-size: 1rem;
    margin: 0;
  }

  @media (max-width: 700px) {
    .ramo-imagen img { height: 260px; }
    .requisitos-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .ramo-cta-inner { flex-direction: column; }
  }
</style>

<script>
  // Highlight active nav pill on scroll
  const sections = document.querySelectorAll<HTMLElement>('.servicio-seccion');
  const pills    = document.querySelectorAll<HTMLAnchorElement>('.nav-pill');

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        pills.forEach(p => {
          p.classList.toggle('active', p.dataset.target === id);
        });
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });

  sections.forEach(s => observer.observe(s));

  // Smooth scroll
  pills.forEach(pill => {
    pill.addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById(pill.dataset.target!);
      if (target) {
        const offset = 130;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });
</script>
