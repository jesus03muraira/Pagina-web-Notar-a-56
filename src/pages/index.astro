---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import SobreNosotros from '../components/SobreNosotros.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Inicio">
  <Hero />
  <Servicios />
  <SobreNosotros />

  <!-- Banner CTA -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2>¿Listo para iniciar tu trámite?</h2>
        <p>Agenda una cita sin costo y recibe orientación personalizada sobre tu caso.</p>
      </div>
      <div class="cta-actions">
        <a href={`${base}/contacto`} class="btn btn-primary">Agendar cita</a>
        <a href="tel:+525500000000" class="btn btn-outline">Llamar ahora</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cta-banner {
    background: var(--color-navy);
    padding: 4rem 0;
    border-top: 3px solid var(--color-gold);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-text h2 {
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .cta-text p {
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
    }
    .cta-actions {
      justify-content: center;
    }
  }
</style>
