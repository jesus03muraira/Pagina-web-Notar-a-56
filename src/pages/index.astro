---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import SobreNosotros from '../components/SobreNosotros.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Inicio">
  <Hero />
  <SobreNosotros />
  <Servicios />

  <!-- Sección de Videos -->
  <section class="videos-section">
    <div class="videos-overlay">
      <p class="section-subtitle videos-subtitle">Conócenos de cerca</p>
      <h2 class="videos-titulo">Notaría en acción</h2>
    </div>
    <video class="vid vid-active" id="vid1" autoplay muted loop playsinline>
      <source src={`${base}/images/video1.mp4`} type="video/mp4" />
    </video>
    <video class="vid" id="vid2" autoplay muted loop playsinline>
      <source src={`${base}/images/video2.mp4`} type="video/mp4" />
    </video>
  </section>

  <!-- Banner CTA -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2>¿Listo para iniciar tu trámite?</h2>
        <p>Agenda una cita sin costo y recibe orientación personalizada sobre tu caso.</p>
      </div>
      <div class="cta-actions">
        <a href={`${base}/contacto`} class="btn btn-primary">Agendar cita</a>
        <a href="tel:+528129679827" class="btn btn-outline">Llamar ahora</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .videos-section {
    position: relative;
    width: 100%;
    height: 85vh;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .vid-active {
    opacity: 1;
  }

  .videos-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 2.5rem 3rem;
    background: linear-gradient(to bottom, rgba(8,20,40,0.65) 0%, transparent 100%);
    pointer-events: none;
  }

  .videos-subtitle {
    color: var(--color-gold) !important;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    margin-bottom: 0.35rem;
  }

  .videos-titulo {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 300;
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
    margin: 0;
  }

  @media (max-width: 700px) {
    .videos-section { height: 60vw; min-height: 280px; }
    .videos-overlay { padding: 1.25rem 1.5rem; }
  }

  .cta-banner {
    background: var(--color-navy);
    padding: 4rem 0;
    border-top: 3px solid var(--color-gold);
    font-family: var(--font-display);
    font-weight: 300;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-text h2 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .cta-text p {
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
    }
    .cta-actions {
      justify-content: center;
    }
  }
</style>

<script>
  const videos = [
    document.getElementById('vid1') as HTMLVideoElement,
    document.getElementById('vid2') as HTMLVideoElement,
  ];
  let current = 0;

  setInterval(() => {
    videos[current].classList.remove('vid-active');
    current = current === 0 ? 1 : 0;
    videos[current].classList.add('vid-active');
  }, 8000);
</script>
