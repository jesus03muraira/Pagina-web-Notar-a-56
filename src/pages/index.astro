---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import SobreNosotros from '../components/SobreNosotros.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Inicio">
  <Hero />
  <SobreNosotros />
  <Servicios />

  <!-- Sección de Videos -->
  <section class="section videos-section">
    <div class="container">
      <div class="videos-header">
        <p class="section-subtitle">Conócenos de cerca</p>
        <h2 class="section-title">Notaría en acción</h2>
        <div class="section-divider"></div>
      </div>
      <div class="videos-grid">
        <div class="video-card">
          <video controls preload="metadata" playsinline>
            <source src={`${base}/images/video1.mp4`} type="video/mp4" />
          </video>
        </div>
        <div class="video-card">
          <video controls preload="metadata" playsinline>
            <source src={`${base}/images/video2.mp4`} type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- Banner CTA -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2>¿Listo para iniciar tu trámite?</h2>
        <p>Agenda una cita sin costo y recibe orientación personalizada sobre tu caso.</p>
      </div>
      <div class="cta-actions">
        <a href={`${base}/contacto`} class="btn btn-primary">Agendar cita</a>
        <a href="tel:+528129679827" class="btn btn-outline">Llamar ahora</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .videos-section {
    background: var(--color-navy-dark);
    padding: 5rem 0;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .videos-header {
    max-width: 520px;
    margin-bottom: 3rem;
  }

  .videos-header .section-subtitle {
    color: var(--color-gold);
  }

  .videos-header .section-title {
    color: var(--color-white);
  }

  .videos-header .section-divider {
    background: var(--color-gold);
  }

  .videos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .video-card {
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.5);
  }

  .video-card video {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  @media (max-width: 700px) {
    .videos-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-banner {
    background: var(--color-navy);
    padding: 4rem 0;
    border-top: 3px solid var(--color-gold);
    font-family: var(--font-display);
    font-weight: 300;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-text h2 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .cta-text p {
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
    }
    .cta-actions {
      justify-content: center;
    }
  }
</style>
