---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Contacto" description="Contáctanos para agendar una cita o resolver tus dudas. Notaría Pública No. 56.">
  <!-- Hero photo a lo largo -->
  <div class="contacto-hero-img">
    <img src={`${base}/images/contacto.jpg`} alt="Contacto Notaría 56" />
  </div>

  <!-- Page Header (recuadro azul) -->
  <section class="page-hero">
    <div class="container">
      <p class="section-subtitle">Estamos para ayudarte</p>
      <h1>Contacto</h1>
      <p class="page-hero-desc">
        Agenda una consulta sin costo, resuelve tus dudas o solicita información
        sobre cualquiera de nuestros servicios.
      </p>
    </div>
  </section>

  <section class="section contacto-section">
    <div class="container">

      <!-- 1. Formulario "Envíanos un mensaje" -->
      <div class="form-wrapper">
        <h2>Envíanos un mensaje</h2>
        <p class="form-intro">
          Completa el formulario y te contactaremos en un plazo máximo de 24 horas hábiles.
        </p>
        <form class="contact-form" id="contactForm">
          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre completo *</label>
              <input type="text" id="nombre" name="nombre" required placeholder="Ej. Juan García López" />
            </div>
            <div class="form-group">
              <label for="email">Correo electrónico *</label>
              <input type="email" id="email" name="email" required placeholder="tucorreo@ejemplo.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="telefono">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" placeholder="81 2967 9827" />
            </div>
            <div class="form-group">
              <label for="servicio">Servicio de interés</label>
              <select id="servicio" name="servicio">
                <option value="">Selecciona un servicio...</option>
                <option>Escrituras y Protocolos</option>
                <option>Poderes Notariales</option>
                <option>Testamentos</option>
                <option>Actas Notariales</option>
                <option>Certificaciones</option>
                <option>Asesoría Jurídica</option>
                <option>Otro</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="mensaje">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" rows="5" required
              placeholder="Describe brevemente tu consulta o el trámite que necesitas realizar..."></textarea>
          </div>

          <div class="form-check">
            <input type="checkbox" id="aviso" name="aviso" required />
            <label for="aviso">
              He leído y acepto el tratamiento de mis datos personales conforme al aviso de privacidad.
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-submit">
            Enviar mensaje
          </button>

          <p class="form-note">* Campos obligatorios</p>
        </form>
      </div>

      <!-- 2. Foto edificio + mapa Google Maps -->
      <div class="visual-row">
        <div class="visual-card">
          <img src={`${base}/images/fotoed.png`} alt="Edificio Notaría Pública No. 56" />
        </div>

        <div class="visual-card mapa-wrapper">
          <iframe
            src="https://maps.google.com/maps?q=Av.+Cordillera+11,+Sin+Nombre+de+Col+28,+Cordillera+Residencial+Fase+Dos,+66196+Cdad.+Santa+Catarina,+N.L.&output=embed&z=16"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Notaría Pública No. 56"
          ></iframe>
          <a
            href="https://maps.google.com/maps?q=Av.+Cordillera+11,+Sin+Nombre+de+Col+28,+Cordillera+Residencial+Fase+Dos,+66196+Cdad.+Santa+Catarina,+N.L."
            target="_blank"
            rel="noopener noreferrer"
            class="mapa-link"
          >
            Ver en Google Maps →
          </a>
        </div>
      </div>

      <!-- 3. Información de contacto en fila -->
      <div class="info-row">
        <div class="info-item">
          <span class="info-icon">📍</span>
          <div>
            <strong>Dirección</strong>
            <p>Av. Cordillera 11, Cordillera Residencial Fase Dos<br />C.P. 66196, Santa Catarina, N.L.</p>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icon">📞</span>
          <div>
            <strong>Teléfono</strong>
            <p>
              <a href="tel:+528129679827">81 2967 9827</a><br />
              <a href="tel:+528132250592">81 3225 0592</a>
            </p>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icon">✉</span>
          <div>
            <strong>Correo electrónico</strong>
            <p><a href="mailto:notario@np56.mx">notario@np56.mx</a></p>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icon">🕐</span>
          <div>
            <strong>Horario de atención</strong>
            <p>Lun – Vie: 9:00 – 18:00 hrs<br />Sáb: 9:00 – 13:00 hrs</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .contacto-hero-img {
    width: 100%;
    line-height: 0;
  }

  .contacto-hero-img img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .page-hero {
    background: var(--color-navy);
    padding: 5rem 0 5rem;
    border-bottom: 3px solid var(--color-gold);
  }

  .page-hero h1 {
    font-family: var(--font-serif);
    color: var(--color-white);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 0.75rem;
  }

  .page-hero-desc {
    color: rgba(255,255,255,0.7);
    max-width: 520px;
    line-height: 1.75;
  }

  .page-hero .section-subtitle {
    margin-bottom: 0.5rem;
  }

  .contacto-section {
    background: var(--color-cream);
  }

  .form-wrapper {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    padding: 2.5rem;
    border-radius: 2px;
    margin-bottom: 3rem;
  }

  .form-wrapper h2 {
    font-family: var(--font-serif);
    color: var(--color-navy);
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .form-intro {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-navy);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-cream);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-navy);
    box-shadow: 0 0 0 3px rgba(26,46,90,0.08);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 130px;
  }

  .form-check {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .form-check input {
    margin-top: 0.2rem;
    flex-shrink: 0;
    accent-color: var(--color-navy);
  }

  .form-check label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .btn-submit {
    align-self: flex-start;
    min-width: 180px;
  }

  .form-note {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  /* Foto + Mapa: dos columnas a la misma altura */
  .visual-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .visual-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
    height: 480px;
    display: flex;
    flex-direction: column;
  }

  .visual-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .mapa-wrapper iframe {
    flex: 1;
    width: 100%;
    border: 0;
    display: block;
  }

  .mapa-link {
    display: block;
    background: var(--color-navy);
    color: var(--color-gold);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 0.7rem 1rem;
    transition: background 0.2s;
  }

  .mapa-link:hover {
    background: var(--color-navy-light);
  }

  /* Info de contacto en fila */
  .info-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-gold);
    padding: 2rem;
    border-radius: 2px;
  }

  .info-item {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .info-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .info-item strong {
    display: block;
    color: var(--color-navy);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }

  .info-item p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .info-item a {
    color: var(--color-navy);
    transition: color 0.2s;
  }

  .info-item a:hover {
    color: var(--color-gold);
  }

  @media (max-width: 900px) {
    .visual-row {
      grid-template-columns: 1fr;
    }
    .visual-card {
      height: 360px;
    }
    .info-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .info-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('.btn-submit') as HTMLButtonElement;
    btn.textContent = '✓ Mensaje enviado';
    btn.disabled = true;
    btn.style.background = '#2e7d32';
    btn.style.borderColor = '#2e7d32';
  });
</script>
