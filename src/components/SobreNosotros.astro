---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bg = `${base}/images/fondonotaria.jpg`;
---

<section class="section nosotros-section" id="nosotros" style={`background-image: url('${bg}')`}>
  <div class="container">

    <!-- Intro principal -->
    <div class="nosotros-intro">
      <p class="section-subtitle reveal" style="--delay: 0s">Fe Pública y Confianza</p>
      <h2 class="nosotros-heading reveal" style="--delay: 0.08s">Sobre Nosotros</h2>
      <p class="nosotros-notario reveal" style="--delay: 0.16s">Lic. Sergio de Jesús Gil Valdez</p>
      <div class="section-divider reveal" style="--delay: 0.24s"></div>

      <p class="nosotros-lead reveal" style="--delay: 0.3s">
        Más de 15 años de trayectoria jurídica, 5 de ellos como Notario Público, brindando seguridad y certeza legal a personas y empresas.
        Atención personalizada, trámites ágiles y asesoría de primer nivel.
      </p>

      <div class="nosotros-actions reveal" style="--delay: 0.38s">
        <a href={`${base}/#servicios`} class="btn btn-outline-dark">Ver servicios</a>
      </div>

      <div class="nosotros-stats reveal" style="--delay: 0.44s">
        <div class="stat">
          <span class="stat-num">+15</span>
          <span class="stat-label">Años de experiencia</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" id="counter-escrituras">+0</span>
          <span class="stat-label">Escrituras firmadas</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">100%</span>
          <span class="stat-label">Respaldo legal</span>
        </div>
      </div>
    </div>

    <!-- Separador dorado entre intro y columnas -->
    <div class="nosotros-separador reveal"></div>

    <!-- Layout en dos columnas → texto + foto -->
    <div class="nosotros-cols">
      <div class="nosotros-text">
        <h3 class="nosotros-subheading reveal">Una notaría con historia y compromiso</h3>
        <p class="reveal" style="--delay: 0.1s">
          Somos una notaría con más de 15 años de trayectoria al servicio de Santa Catarina
          y la Zona Metropolitana de Monterrey, brindando certeza jurídica a familias,
          empresas y particulares.
        </p>
        <p class="reveal" style="--delay: 0.18s">
          Ofrecemos un servicio ágil y profesional, apegado al marco legal vigente, con la
          atención cercana y personalizada que cada cliente merece. Nuestro equipo de abogados
          acompaña cada trámite con claridad, eficiencia y discreción.
        </p>
        <p class="reveal" style="--delay: 0.26s">
          Somos miembros activos del Colegio de Notarios Públicos del Estado de Nuevo León
          y del Colegio Nacional del Notariado Mexicano.
        </p>

        <ul class="valores-list">
          <li class="reveal" style="--delay: 0.32s">
            <span class="valor-icon">✦</span>
            <div>
              <strong>Integridad</strong>
              <span>Actuamos siempre conforme a la ley y la ética profesional.</span>
            </div>
          </li>
          <li class="reveal" style="--delay: 0.42s">
            <span class="valor-icon">✦</span>
            <div>
              <strong>Confidencialidad</strong>
              <span>Todos los asuntos son tratados con absoluta discreción.</span>
            </div>
          </li>
          <li class="reveal" style="--delay: 0.52s">
            <span class="valor-icon">✦</span>
            <div>
              <strong>Agilidad</strong>
              <span>Trámites eficientes sin sacrificar la calidad jurídica.</span>
            </div>
          </li>
        </ul>
      </div>

      <div class="nosotros-foto reveal reveal--right" style="--delay: 0.15s">
        <img
          src={`${base}/images/notario1.jpg`}
          alt="Lic. Sergio de Jesús Gil Valdez, Notario Público No. 56"
        />
      </div>
    </div>

    <!-- Horario debajo del contenido principal -->
    <div class="horario-bottom reveal">
      <p class="horario-label">Horario de Atención</p>
      <div class="horario-grid">
        <div class="horario-item">
          <span class="horario-dia">Lunes – Viernes</span>
          <span class="horario-hora">9:00 – 18:00</span>
        </div>
        <div class="horario-sep"></div>
        <div class="horario-item">
          <span class="horario-dia">Sábado</span>
          <span class="horario-hora">9:00 – 13:00</span>
        </div>
        <div class="horario-sep"></div>
        <div class="horario-item">
          <span class="horario-dia">Domingo</span>
          <span class="horario-hora">Cerrado</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .nosotros-section {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    padding: 9rem 0;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .nosotros-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 40, 0.82);
    z-index: 0;
  }

  .nosotros-section .container {
    position: relative;
    z-index: 1;
  }

  /* ── Animaciones de aparición al hacer scroll ── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
    will-change: opacity, transform;
  }

  .reveal--right {
    transform: translateX(40px);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Intro principal */
  .nosotros-intro {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .nosotros-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .nosotros-notario {
    color: var(--color-gold-pale);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
  }

  .nosotros-lead {
    color: rgba(255,255,255,0.92);
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    line-height: 1.7;
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    max-width: 720px;
  }

  .nosotros-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .nosotros-stats {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.2);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    color: var(--color-gold-pale);
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
  }

  .stat-label {
    color: rgba(255,255,255,0.82);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    margin-top: 0.35rem;
  }

  .stat-divider {
    width: 1px;
    height: 2.75rem;
    background: rgba(255,255,255,0.2);
  }

  /* Separador dorado entre intro y columnas */
  .nosotros-separador {
    width: 48px;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.6;
    margin-bottom: 2.5rem;
  }

  .nosotros-cols {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 3rem;
    align-items: start;
  }

  .nosotros-foto {
    border-radius: 2px;
    overflow: hidden;
    flex-shrink: 0;
    aspect-ratio: 3 / 4;
    box-shadow: 0 12px 40px rgba(0,0,0,0.6);
  }

  .nosotros-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* h3: claramente distinto del lead */
  .nosotros-subheading {
    font-family: var(--font-display);
    color: var(--color-white);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .nosotros-text p {
    color: rgba(255,255,255,0.82);
    margin-bottom: 1.25rem;
    line-height: 1.85;
  }

  /* Valores — señales de confianza visualmente reforzadas */
  .valores-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 2rem;
    padding: 0;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .valores-list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 1rem 1rem 1.15rem;
    border-left: 2px solid rgba(158,124,63,0.35);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: border-left-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
    cursor: default;
  }

  .valores-list li:hover {
    border-left-color: var(--color-gold);
    background: rgba(255,255,255,0.04);
    transform: translateX(4px);
  }

  .valor-icon {
    color: var(--color-gold);
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .valores-list strong {
    display: block;
    color: var(--color-white);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
    letter-spacing: 0.02em;
  }

  .valores-list span {
    color: rgba(255,255,255,0.82);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  /* Horario */
  .horario-bottom {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.2);
  }

  .horario-label {
    color: var(--color-gold);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .horario-grid {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .horario-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .horario-dia {
    color: rgba(255,255,255,0.82);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .horario-hora {
    color: var(--color-gold-pale);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .horario-sep {
    width: 1px;
    height: 2.5rem;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .nosotros-intro {
      margin-bottom: 2rem;
    }
    .nosotros-cols {
      grid-template-columns: 1fr;
    }
    .nosotros-foto {
      max-width: 340px;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 600px) {
    .nosotros-section { padding: 5rem 0; }
    .horario-sep { display: none; }
    .horario-grid { gap: 1.25rem; }
    .stat-divider { display: none; }
    .nosotros-stats { gap: 1.5rem 2rem; }
    .valores-list li:hover { transform: none; }
  }
</style>

<script>
  // Reveal al hacer scroll
  const revealEls = document.querySelectorAll('.nosotros-section .reveal');
  const revealObserver = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
  );
  revealEls.forEach(el => revealObserver.observe(el));

  const el = document.getElementById('counter-escrituras');
  if (el) {
    const target = 1000;
    const duration = 3000;
    let started = false;

    const run = () => {
      if (started) return;
      started = true;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        // easeOutQuart — arranca rápido y desacelera al llegar a 1000
        const eased = 1 - Math.pow(1 - progress, 4);
        const value = Math.floor(eased * target);
        el.textContent = `+${value.toLocaleString('es-MX')}`;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = '+1,000';
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      entries => { if (entries[0].isIntersecting) run(); },
      { threshold: 0.4 }
    );
    observer.observe(el);
  }
</script>
