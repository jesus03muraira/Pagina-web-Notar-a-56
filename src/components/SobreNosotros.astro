---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bg = `${base}/images/fondonotaria.jpg`;
---

<section class="section nosotros-section" id="nosotros" style={`background-image: url('${bg}')`}>

  <!-- "56" fantasma de fondo -->
  <span class="nosotros-ghost" aria-hidden="true">56</span>

  <div class="container">

    <!-- Header editorial -->
    <header class="nosotros-header">
      <div class="nosotros-eyebrow reveal" style="--delay: 0s">
        <span class="eyebrow-line"></span>
        <span>Fe Pública y Confianza</span>
      </div>
      <h2 class="nosotros-titulo reveal" style="--delay: 0.08s">
        <span class="titulo-small">Sobre</span>
        <span class="titulo-large">Nosotros</span>
      </h2>
    </header>

    <!-- Grid editorial asimétrico -->
    <div class="nosotros-grid">

      <!-- Columna texto -->
      <div class="nosotros-col-texto">
        <p class="nosotros-notario reveal" style="--delay: 0.14s">Lic. Sergio de Jesús Gil Valdez</p>
        <div class="section-divider reveal" style="--delay: 0.2s"></div>

        <p class="nosotros-lead reveal" style="--delay: 0.26s">
          Más de 15 años de trayectoria jurídica, 5 de ellos como Notario Público,
          brindando seguridad y certeza legal a personas y empresas. Atención
          personalizada, trámites ágiles y asesoría de primer nivel.
        </p>

        <div class="nosotros-actions reveal" style="--delay: 0.32s">
          <a href={`${base}/#servicios`} class="btn btn-outline-dark">Ver servicios</a>
        </div>

        <div class="nosotros-body">
          <p class="reveal" style="--delay: 0.12s">
            Somos una notaría con más de 15 años de trayectoria al servicio de Santa Catarina
            y la Zona Metropolitana de Monterrey, brindando certeza jurídica a familias,
            empresas y particulares.
          </p>
          <p class="reveal" style="--delay: 0.2s">
            Ofrecemos un servicio ágil y profesional, apegado al marco legal vigente, con la
            atención cercana y personalizada que cada cliente merece. Somos miembros activos
            del Colegio de Notarios Públicos del Estado de Nuevo León y del Colegio Nacional
            del Notariado Mexicano.
          </p>
        </div>
      </div>

      <!-- Columna foto con marco editorial dorado -->
      <div class="nosotros-col-foto reveal reveal--right" style="--delay: 0.2s">
        <div class="foto-wrapper">
          <img
            src={`${base}/images/notario1.jpg`}
            alt="Lic. Sergio de Jesús Gil Valdez, Notario Público No. 56"
          />
          <div class="foto-credencial">
            <span class="cred-titulo">Notario Público No. 56</span>
            <span class="cred-lugar">Santa Catarina, Nuevo León</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Banda de estadísticas -->
    <div class="nosotros-stats reveal" style="--delay: 0.05s">
      <div class="stat-item">
        <span class="stat-num">+15</span>
        <span class="stat-label">Años de<br/>experiencia</span>
      </div>
      <div class="stat-divider-v"></div>
      <div class="stat-item">
        <span class="stat-num" id="counter-escrituras">+0</span>
        <span class="stat-label">Escrituras<br/>firmadas</span>
      </div>
      <div class="stat-divider-v"></div>
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Respaldo<br/>legal</span>
      </div>
    </div>

    <!-- Valores: tarjetas modernas -->
    <div class="nosotros-valores">
      <article class="valor-card reveal" style="--delay: 0s">
        <span class="valor-num" aria-hidden="true">01</span>
        <div class="valor-top">
          <span class="valor-rule"></span>
        </div>
        <strong class="valor-titulo">Integridad</strong>
        <span class="valor-desc">Actuamos siempre conforme a la ley y la ética profesional.</span>
      </article>
      <article class="valor-card reveal" style="--delay: 0.12s">
        <span class="valor-num" aria-hidden="true">02</span>
        <div class="valor-top">
          <span class="valor-rule"></span>
        </div>
        <strong class="valor-titulo">Confidencialidad</strong>
        <span class="valor-desc">Todos los asuntos son tratados con absoluta discreción.</span>
      </article>
      <article class="valor-card reveal" style="--delay: 0.24s">
        <span class="valor-num" aria-hidden="true">03</span>
        <div class="valor-top">
          <span class="valor-rule"></span>
        </div>
        <strong class="valor-titulo">Agilidad</strong>
        <span class="valor-desc">Trámites eficientes sin sacrificar la calidad jurídica.</span>
      </article>
    </div>

    <!-- Horario -->
    <div class="horario-bottom reveal">
      <p class="horario-label">Horario de Atención</p>
      <div class="horario-grid">
        <div class="horario-item">
          <span class="horario-dia">Lunes – Viernes</span>
          <span class="horario-hora">9:00 – 18:00</span>
        </div>
        <div class="horario-sep"></div>
        <div class="horario-item">
          <span class="horario-dia">Sábado</span>
          <span class="horario-hora">9:00 – 13:00</span>
        </div>
        <div class="horario-sep"></div>
        <div class="horario-item">
          <span class="horario-dia">Domingo</span>
          <span class="horario-hora">Cerrado</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Sección base ── */
  .nosotros-section {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    padding: 10rem 0 8rem;
    font-family: var(--font-display);
    font-weight: 300;
    overflow: hidden;
  }

  .nosotros-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 40, 0.90);
    z-index: 0;
  }

  .nosotros-section .container {
    position: relative;
    z-index: 1;
  }

  /* ── "56" fantasma ── */
  .nosotros-ghost {
    position: absolute;
    top: -3rem;
    right: -3vw;
    font-family: var(--font-display);
    font-size: clamp(16rem, 28vw, 34rem);
    font-weight: 800;
    color: rgba(158, 124, 63, 0.05);
    line-height: 1;
    letter-spacing: -0.05em;
    user-select: none;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Header editorial ── */
  .nosotros-header {
    margin-bottom: 5rem;
  }

  .nosotros-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .eyebrow-line {
    display: block;
    width: 36px;
    height: 1px;
    background: var(--color-gold);
    flex-shrink: 0;
  }

  .nosotros-eyebrow span:last-child {
    color: var(--color-gold);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .nosotros-titulo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    margin: 0;
  }

  .titulo-small {
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 0.15em;
  }

  .titulo-large {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-white);
    text-transform: uppercase;
    line-height: 0.88;
  }

  /* ── Grid editorial ── */
  .nosotros-grid {
    display: grid;
    grid-template-columns: 1fr 44%;
    gap: 5rem;
    align-items: start;
    margin-bottom: 6rem;
  }

  .nosotros-notario {
    color: var(--color-gold-pale);
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .nosotros-lead {
    color: rgba(255,255,255,0.92);
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.8;
    margin-top: 1.25rem;
    margin-bottom: 2rem;
  }

  .nosotros-actions {
    margin-bottom: 2.5rem;
  }

  /* Sobrescribir btn-outline-dark para fondo oscuro */
  .nosotros-actions .btn-outline-dark {
    color: var(--color-gold-pale);
    border-color: rgba(158, 124, 63, 0.6);
  }

  .nosotros-actions .btn-outline-dark:hover {
    background: rgba(158, 124, 63, 0.12);
    color: var(--color-white);
    border-color: var(--color-gold-pale);
  }

  .nosotros-body p {
    color: rgba(255,255,255,0.65);
    font-size: 0.92rem;
    line-height: 1.95;
    margin-bottom: 1rem;
  }

  /* ── Foto con marco dorado desplazado ── */
  .nosotros-col-foto {
    position: relative;
    padding: 14px 0 0 14px;
  }

  .foto-wrapper {
    position: relative;
  }

  /* Marco dorado desplazado */
  .foto-wrapper::before {
    content: '';
    position: absolute;
    top: -14px;
    left: -14px;
    right: 14px;
    bottom: 14px;
    border: 1px solid rgba(158, 124, 63, 0.55);
    pointer-events: none;
    z-index: 2;
    transition: border-color 0.4s ease;
  }

  .nosotros-col-foto:hover .foto-wrapper::before {
    border-color: rgba(158, 124, 63, 0.85);
  }

  .foto-wrapper img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }

  /* Credencial sobre la foto */
  .foto-credencial {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(
      to top,
      rgba(8, 20, 40, 0.95) 0%,
      rgba(8, 20, 40, 0.55) 55%,
      transparent 100%
    );
    padding: 2.5rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 3;
  }

  .cred-titulo {
    color: var(--color-gold-pale);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .cred-lugar {
    color: rgba(255,255,255,0.5);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  /* ── Banda de estadísticas ── */
  .nosotros-stats {
    display: flex;
    align-items: stretch;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 5rem;
  }

  .stat-item {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 3rem 2.5rem;
  }

  .stat-num {
    color: var(--color-gold-pale);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    color: rgba(255,255,255,0.5);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .stat-divider-v {
    width: 1px;
    background: rgba(255,255,255,0.12);
    flex-shrink: 0;
    align-self: stretch;
  }

  /* ── Valores: tarjetas modernas ── */
  .nosotros-valores {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  .valor-card {
    position: relative;
    padding: 2.5rem 2rem 2.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
    transition: background 0.4s ease, border-color 0.4s ease, transform 0.4s ease;
    cursor: default;
  }

  .valor-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 100% at 0% 0%,
      rgba(158, 124, 63, 0.10) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .valor-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(158, 124, 63, 0.45);
    transform: translateY(-6px);
  }

  .valor-card:hover::after {
    opacity: 1;
  }

  /* Número grande de marca de agua */
  .valor-num {
    position: absolute;
    top: 0.5rem;
    right: 1.25rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1;
    color: rgba(158, 124, 63, 0.10);
    letter-spacing: -0.04em;
    transition: color 0.4s ease;
    z-index: 0;
  }

  .valor-card:hover .valor-num {
    color: rgba(158, 124, 63, 0.20);
  }

  .valor-top {
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;
  }

  .valor-rule {
    display: block;
    width: 36px;
    height: 2px;
    background: var(--color-gold);
    transition: width 0.4s ease;
  }

  .valor-card:hover .valor-rule {
    width: 54px;
  }

  .valor-titulo {
    position: relative;
    z-index: 1;
    display: block;
    color: var(--color-white);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .valor-desc {
    position: relative;
    z-index: 1;
    display: block;
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* ── Horario ── */
  .horario-bottom {
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .horario-label {
    color: var(--color-gold);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .horario-grid {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .horario-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .horario-dia {
    color: rgba(255,255,255,0.5);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .horario-hora {
    color: var(--color-gold-pale);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .horario-sep {
    width: 1px;
    height: 2rem;
    background: rgba(255,255,255,0.15);
    flex-shrink: 0;
  }

  /* ── Animaciones reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
    will-change: opacity, transform;
  }

  .reveal--right {
    transform: translateX(44px);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .nosotros-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .nosotros-col-foto {
      max-width: 400px;
    }
    .nosotros-ghost {
      font-size: clamp(10rem, 38vw, 18rem);
    }
    .nosotros-valores {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .stat-item { padding: 2.5rem 1.5rem; }
  }

  @media (max-width: 600px) {
    .nosotros-section { padding: 6rem 0 5rem; }
    .titulo-large { font-size: clamp(3rem, 16vw, 5rem); }
    .nosotros-stats {
      flex-wrap: wrap;
      border: none;
      gap: 0;
    }
    .stat-item {
      flex: 0 0 50%;
      padding: 1.5rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .stat-divider-v { display: none; }
    .horario-sep { display: none; }
    .horario-grid { gap: 1.5rem; }
  }
</style>

<script>
  // Reveal al hacer scroll
  const revealEls = document.querySelectorAll('.nosotros-section .reveal');
  const revealObserver = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
  );
  revealEls.forEach(el => revealObserver.observe(el));

  // Counter escrituras
  const el = document.getElementById('counter-escrituras');
  if (el) {
    const target = 1000;
    const duration = 3000;
    let started = false;

    const run = () => {
      if (started) return;
      started = true;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        const value = Math.floor(eased * target);
        el.textContent = `+${value.toLocaleString('es-MX')}`;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = '+1,000';
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      entries => { if (entries[0].isIntersecting) run(); },
      { threshold: 0.4 }
    );
    observer.observe(el);
  }
</script>
