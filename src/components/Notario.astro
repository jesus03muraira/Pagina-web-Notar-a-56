---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const membresias = [
  'Colegio de Notarios Públicos del Estado de Nuevo León',
  'Colegio Nacional del Notariado Mexicano',
];
---

<section class="notario-section" id="notario">
  <div class="container notario-inner">

    <!-- Header editorial -->
    <header class="notario-header reveal">
      <div class="notario-eyebrow">
        <span class="eyebrow-line"></span>
        <span>Trayectoria</span>
      </div>
      <h2 class="notario-titulo">
        <span class="titulo-small">El</span>
        <span class="titulo-large">Notario</span>
      </h2>
      <p class="notario-nombre">Lic. Sergio de Jesús Gil Valdez</p>
    </header>

    <div class="notario-grid">

      <!-- Biografía -->
      <div class="notario-bio">
        <p class="reveal" style="--delay: 0.08s">
          Licenciado en Derecho por el Tecnológico de Monterrey (ITESM); obtuvo la
          maestría LLM en (x), trabajó en (...).
        </p>
        <p class="reveal" style="--delay: 0.16s">
          El (x) de (x) del año (x) recibió la patente de Notario Público Titular de la
          Notaría Pública No. 56, con demarcación notarial en el Primer Distrito Registral
          y domicilio en el municipio de Santa Catarina, Nuevo León.
        </p>
      </div>

      <!-- Membresías -->
      <aside class="notario-membresias reveal" style="--delay: 0.24s">
        <span class="membresias-label">Miembro activo de</span>
        <ul>
          {membresias.map(m => (
            <li>
              <span class="membresia-mark" aria-hidden="true"></span>
              <span>{m}</span>
            </li>
          ))}
        </ul>
      </aside>

    </div>
  </div>
</section>

<style>
  .notario-section {
    background: var(--color-cream);
    padding: 7rem 0;
    font-family: var(--font-display);
    font-weight: 300;
    position: relative;
    overflow: hidden;
  }

  /* "56" fantasma de fondo, sutil */
  .notario-section::before {
    content: '56';
    position: absolute;
    bottom: -6rem;
    left: -2vw;
    font-size: clamp(14rem, 26vw, 30rem);
    font-weight: 800;
    color: rgba(13, 27, 46, 0.035);
    line-height: 1;
    letter-spacing: -0.05em;
    pointer-events: none;
    user-select: none;
  }

  .notario-inner {
    position: relative;
    z-index: 1;
  }

  /* Header editorial */
  .notario-header {
    max-width: 760px;
    margin-bottom: 3.5rem;
  }

  .notario-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .eyebrow-line {
    display: block;
    width: 36px;
    height: 1px;
    background: var(--color-gold);
    flex-shrink: 0;
  }

  .notario-eyebrow span:last-child {
    color: var(--color-gold);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .notario-titulo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    margin: 0 0 1.25rem;
  }

  .titulo-small {
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(13, 27, 46, 0.4);
    margin-bottom: 0.15em;
  }

  .titulo-large {
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-navy);
    text-transform: uppercase;
    line-height: 0.88;
  }

  .notario-nombre {
    color: var(--color-gold);
    font-style: italic;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  /* Grid bio + membresías */
  .notario-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  .notario-bio p {
    color: rgba(13, 27, 46, 0.8);
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    line-height: 1.9;
    margin-bottom: 1.4rem;
  }

  /* Membresías */
  .notario-membresias {
    border-left: 2px solid var(--color-gold);
    padding-left: 1.75rem;
  }

  .membresias-label {
    display: block;
    color: var(--color-gold);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .notario-membresias ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .notario-membresias li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    color: var(--color-navy);
    font-size: 0.98rem;
    line-height: 1.5;
    font-weight: 400;
  }

  .membresia-mark {
    width: 7px;
    height: 7px;
    margin-top: 0.55em;
    flex-shrink: 0;
    background: var(--color-gold);
    transform: rotate(45deg);
  }

  /* Reveal */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }

  @media (max-width: 900px) {
    .notario-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .notario-membresias {
      max-width: 480px;
    }
  }

  @media (max-width: 600px) {
    .notario-section { padding: 5rem 0; }
  }
</style>

<script>
  const els = document.querySelectorAll('.notario-section .reveal');
  const obs = new IntersectionObserver(
    (entries, o) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          o.unobserve(e.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  els.forEach(el => obs.observe(el));
</script>
