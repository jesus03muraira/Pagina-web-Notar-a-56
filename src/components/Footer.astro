---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo">
        <img
          src={`${base}/images/Notaria-56-logo.png`}
          alt="Notaría Pública No. 56"
          class="footer-logo-img"
        />
      </div>
      <p class="footer-notario">Lic. Sergio de Jesús Gil Valdez</p>
      <p class="footer-tagline">
        Fe pública, confianza y profesionalismo al servicio de la comunidad.
      </p>
    </div>

    <div class="footer-col">
      <h4>Servicios</h4>
      <ul>
        <li><a href={`${base}/servicios/inmobiliarios`}>Inmobiliarios</a></li>
        <li><a href={`${base}/servicios/mercantil-y-societario`}>Mercantil y Societario</a></li>
        <li><a href={`${base}/servicios/patrimoniales-y-sucesorios`}>Patrimoniales y Sucesorios</a></li>
        <li><a href={`${base}/servicios/familiares`}>Familiares</a></li>
        <li><a href={`${base}/servicios/poderes`}>Poderes</a></li>
        <li><a href={`${base}/servicios/fe-publica-y-certificaciones`}>Fe Pública y Certificaciones</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Navegación</h4>
      <ul>
        <li><a href={`${base}/`}>Inicio</a></li>
        <li><a href={`${base}/#nosotros`}>Nosotros</a></li>
        <li><a href={`${base}/blog`}>Blog</a></li>
        <li><a href={`${base}/contacto`}>Contacto</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contacto</h4>
      <ul class="footer-contact">
        <li>
          <span class="icon">📍</span>
          <span>Av. Cordillera 11, Cordillera Residencial Fase Dos,<br />C.P. 66196, Santa Catarina, N.L.</span>
        </li>
        <li>
          <span class="icon">📞</span>
          <a href="tel:+525500000000">55 0000 0000</a>
        </li>
        <li>
          <span class="icon">✉</span>
          <a href="mailto:contacto@notaria56.mx">contacto@notaria56.mx</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} Notaría Pública No. 56 — Lic. Sergio de Jesús Gil Valdez. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-dark);
    color: rgba(255,255,255,0.75);
    padding-top: 3.5rem;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    margin-bottom: 0.9rem;
  }

  .footer-logo-img {
    height: 4rem;
    width: auto;
    display: block;
  }

  .footer-notario {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-style: italic;
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }

  .footer-tagline {
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 240px;
    color: rgba(255,255,255,0.5);
  }

  .footer-col h4 {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(158,124,63,0.3);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    color: rgba(255,255,255,0.6);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-gold);
  }

  .footer-contact li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.875rem;
    align-items: flex-start;
    color: rgba(255,255,255,0.6);
  }

  .footer-contact .icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 1.25rem 0;
    text-align: center;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.3);
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
