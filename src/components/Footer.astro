---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo">
        <img
          src={`${base}/images/Notaria-56-logo.png`}
          alt="Notaría Pública No. 56"
          class="footer-logo-img"
        />
      </div>
      <p class="footer-notario">Lic. Sergio de Jesús Gil Valdez</p>
      <p class="footer-tagline">
        Fe pública, confianza y profesionalismo al servicio de la comunidad.
      </p>
    </div>

    <div class="footer-col">
      <h4>Servicios</h4>
      <ul>
        <li><a href={`${base}/servicios/inmobiliarios`}>Inmobiliarios</a></li>
        <li><a href={`${base}/servicios/mercantil-y-societario`}>Mercantil y Societario</a></li>
        <li><a href={`${base}/servicios/patrimoniales-y-sucesorios`}>Patrimoniales y Sucesorios</a></li>
        <li><a href={`${base}/servicios/familiares`}>Familiares</a></li>
        <li><a href={`${base}/servicios/poderes`}>Poderes</a></li>
        <li><a href={`${base}/servicios/fe-publica-y-certificaciones`}>Fe Pública y Certificaciones</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Navegación</h4>
      <ul>
        <li><a href={`${base}/`}>Inicio</a></li>
        <li><a href={`${base}/#nosotros`}>Nosotros</a></li>
        <li><a href={`${base}/blog`}>Blog</a></li>
        <li><a href={`${base}/contacto`}>Contacto</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contacto</h4>
      <ul class="footer-contact">
        <li>
          <span class="icon">📍</span>
          <span>Av. Cordillera 11, Cordillera Residencial Fase Dos,<br />C.P. 66196, Santa Catarina, N.L.</span>
        </li>
        <li>
          <span class="icon">📞</span>
          <span class="footer-tels">
            <a href="tel:+528129679827">81 2967 9827</a>
            <span class="tel-sep">/</span>
            <a href="tel:+528132250592">81 3225 0592</a>
          </span>
        </li>
        <li>
          <span class="icon">✉</span>
          <a href="mailto:notario@np56.mx">notario@np56.mx</a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/np56.mx?igsh=M2s5bWJ2dHEwdXB1"
            target="_blank"
            rel="noopener noreferrer"
            class="instagram-btn"
            aria-label="Instagram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </li>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} Notaría Pública No. 56 — Lic. Sergio de Jesús Gil Valdez. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-dark);
    color: rgba(255,255,255,0.75);
    padding-top: 3.5rem;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    margin-bottom: 0.9rem;
  }

  .footer-logo-img {
    height: 7rem;
    width: auto;
    display: block;
  }

  .footer-notario {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-style: italic;
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }

  .footer-tagline {
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 240px;
    color: rgba(255,255,255,0.5);
  }

  .footer-col h4 {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(158,124,63,0.3);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    color: rgba(255,255,255,0.6);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-gold);
  }

  .footer-contact li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.875rem;
    align-items: flex-start;
    color: rgba(255,255,255,0.6);
  }

  .footer-contact .icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .instagram-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    color: #fff !important;
    transition: opacity 0.2s;
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  .instagram-btn:hover {
    opacity: 0.8;
  }

  .footer-tels {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .footer-tels .tel-sep {
    color: rgba(255,255,255,0.3);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 1.25rem 0;
    text-align: center;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.3);
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
