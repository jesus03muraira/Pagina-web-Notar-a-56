---
import Layout from '../layouts/Layout.astro';

interface Props {
  titulo: string;
  intro: string;
  servicios: string[];
}

const { titulo, intro, servicios } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={titulo}>
  <section class="ramo-hero">
    <div class="container">
      <a href={`${base}/#servicios`} class="ramo-back">← Servicios</a>
      <p class="section-subtitle">Ramo notarial</p>
      <h1>{titulo}</h1>
      <p class="ramo-intro">{intro}</p>
    </div>
  </section>

  <section class="section ramo-section">
    <div class="container">
      <h2 class="ramo-subtitle">Trámites que ofrecemos</h2>
      <ul class="ramo-list">
        {servicios.map(s => (
          <li>
            <span class="ramo-bullet">✦</span>
            <span>{s}</span>
          </li>
        ))}
      </ul>

      <div class="ramo-cta">
        <p>¿Necesitas asesoría sobre alguno de estos trámites?</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Agendar consulta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ramo-hero {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 7rem 0 4.5rem;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-back {
    color: var(--color-gold-pale);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .ramo-back:hover {
    color: var(--color-white);
  }

  .ramo-hero :global(.section-subtitle) {
    color: var(--color-gold);
  }

  .ramo-hero h1 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: 0.04em;
    margin: 0.4rem 0 1.5rem;
  }

  .ramo-intro {
    max-width: 640px;
    color: rgba(255,255,255,0.78);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .ramo-section {
    background: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-subtitle {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-gold);
    display: inline-block;
    letter-spacing: 0.03em;
  }

  .ramo-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 820px;
    margin: 0 0 3.5rem;
    padding: 0;
  }

  .ramo-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    padding: 1.1rem 1.5rem;
    color: var(--color-navy);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .ramo-bullet {
    color: var(--color-gold);
    font-size: 0.7rem;
    margin-top: 0.4rem;
    flex-shrink: 0;
  }

  .ramo-cta {
    background: var(--color-white);
    border-top: 3px solid var(--color-gold);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 820px;
  }

  .ramo-cta p {
    color: var(--color-text);
    font-size: 1rem;
    margin: 0;
  }

  @media (max-width: 700px) {
    .ramo-list {
      grid-template-columns: 1fr;
    }
    .ramo-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
