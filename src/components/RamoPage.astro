---
import Layout from '../layouts/Layout.astro';

interface Seccion {
  titulo: string;
  items: string[];
}

interface ServicioDetalle {
  titulo: string;
  secciones: Seccion[];
}

type Servicio = string | ServicioDetalle;

interface Props {
  titulo: string;
  intro: string;
  servicios: Servicio[];
  imagen?: string;
}

const { titulo, intro, servicios, imagen } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function esDetalle(s: Servicio): s is ServicioDetalle {
  return typeof s === 'object';
}
---

<Layout title={titulo}>
  <section class="ramo-hero">
    <div class="container">
      <a href={`${base}/#servicios`} class="ramo-back">← Servicios</a>
      <h1>{titulo}</h1>
      <p class="ramo-intro">{intro}</p>
    </div>
  </section>

  {imagen && (
    <div class="ramo-imagen">
      <img src={imagen} alt={titulo} />
    </div>
  )}

  <section class="section ramo-section">
    <div class="container">
      <h2 class="ramo-subtitle">Trámites que ofrecemos</h2>

      <ul class="ramo-list">
        {servicios.map(s => (
          esDetalle(s) ? (
            <li class="ramo-item-accordion">
              <details>
                <summary>
                  <span class="ramo-bullet">✦</span>
                  <span class="ramo-item-titulo">{s.titulo}</span>
                  <span class="ramo-chevron">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <div class="ramo-requisitos">
                  {s.secciones.map(sec => (
                    <div class="req-seccion">
                      <h4 class="req-titulo">{sec.titulo}</h4>
                      <ol class="req-lista">
                        {sec.items.map(item => (
                          <li>{item}</li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </div>
              </details>
            </li>
          ) : (
            <li class="ramo-item-simple">
              <span class="ramo-bullet">✦</span>
              <span>{s}</span>
            </li>
          )
        ))}
      </ul>

      <div class="ramo-cta">
        <p>¿Necesitas asesoría sobre alguno de estos trámites?</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Agendar consulta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ramo-hero {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 7rem 0 4.5rem;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-back {
    color: var(--color-gold-pale);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .ramo-back:hover {
    color: var(--color-white);
  }

  .ramo-hero :global(.section-subtitle) {
    color: var(--color-gold);
  }

  .ramo-hero h1 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: 0.04em;
    margin: 0.4rem 0 1.5rem;
  }

  .ramo-intro {
    max-width: 640px;
    color: rgba(255,255,255,0.78);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .ramo-section {
    background: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-subtitle {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-gold);
    display: inline-block;
    letter-spacing: 0.03em;
  }

  .ramo-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 820px;
    margin: 0 0 3.5rem;
    padding: 0;
  }

  /* Servicios simples (sin detalle) */
  .ramo-item-simple {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    padding: 1.1rem 1.5rem;
    color: var(--color-navy);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  /* Servicios con acordeón */
  .ramo-item-accordion {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
  }

  .ramo-item-accordion details {
    width: 100%;
  }

  .ramo-item-accordion summary {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-navy);
    font-size: 0.98rem;
    line-height: 1.5;
    user-select: none;
    transition: background 0.15s;
  }

  .ramo-item-accordion summary::-webkit-details-marker { display: none; }

  .ramo-item-accordion summary:hover {
    background: var(--color-cream);
  }

  .ramo-item-titulo {
    flex: 1;
    font-weight: 500;
  }

  .ramo-chevron {
    color: var(--color-gold);
    display: flex;
    align-items: center;
    transition: transform 0.25s;
    flex-shrink: 0;
  }

  .ramo-item-accordion details[open] .ramo-chevron {
    transform: rotate(180deg);
  }

  /* Contenido desplegable */
  .ramo-requisitos {
    padding: 0 1.5rem 1.5rem 3rem;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .req-seccion {
    padding-top: 1.25rem;
  }

  .req-titulo {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(158,124,63,0.3);
  }

  .req-lista {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .req-lista li {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .ramo-bullet {
    color: var(--color-gold);
    font-size: 0.7rem;
    margin-top: 0.4rem;
    flex-shrink: 0;
  }

  .ramo-cta {
    background: var(--color-white);
    border-top: 3px solid var(--color-gold);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 820px;
  }

  .ramo-cta p {
    color: var(--color-text);
    font-size: 1rem;
    margin: 0;
  }

  .ramo-imagen {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    line-height: 0;
  }

  .ramo-imagen img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 700px) {
    .ramo-list {
      grid-template-columns: 1fr;
    }
    .ramo-cta {
      flex-direction: column;
      align-items: flex-start;
    }
    .ramo-imagen img {
      height: 260px;
    }
    .ramo-requisitos {
      grid-template-columns: 1fr;
      padding-left: 1.5rem;
    }
  }
</style>
