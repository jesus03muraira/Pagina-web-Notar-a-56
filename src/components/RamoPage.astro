---
import Layout from '../layouts/Layout.astro';

interface Seccion {
  titulo: string;
  items: string[];
}

interface ServicioDetalle {
  titulo: string;
  secciones: Seccion[];
}

type Servicio = string | ServicioDetalle;

interface Props {
  titulo: string;
  intro: string;
  servicios: Servicio[];
  imagen?: string;
}

const { titulo, intro, servicios, imagen } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function esDetalle(s: Servicio): s is ServicioDetalle {
  return typeof s === 'object';
}
---

<Layout title={titulo}>
  <section class="ramo-hero">
    <div class="container">
      <a href={`${base}/#servicios`} class="ramo-back">← Servicios</a>
      <h1>{titulo}</h1>
      <p class="ramo-intro">{intro}</p>
    </div>
  </section>

  {imagen && (
    <div class="ramo-imagen">
      <img src={imagen} alt={titulo} />
    </div>
  )}

  <section class="section ramo-section">
    <div class="container">
      <h2 class="ramo-subtitle">Trámites que ofrecemos</h2>

      <ul class="ramo-list">
        {servicios.map((s, i) => (
          esDetalle(s) ? (
            <li class="ramo-item-simple ramo-item-clickable" data-modal={`modal-${i}`}>
              <span class="ramo-bullet">✦</span>
              <span class="ramo-item-titulo">{s.titulo}</span>
              <span class="ramo-ver">Ver requisitos →</span>
            </li>
          ) : (
            <li class="ramo-item-simple">
              <span class="ramo-bullet">✦</span>
              <span>{s}</span>
            </li>
          )
        ))}
      </ul>

      <!-- Modales -->
      {servicios.map((s, i) => (
        esDetalle(s) && (
          <div class="modal-overlay" id={`modal-${i}`} role="dialog" aria-modal="true">
            <div class="modal-box">
              <button class="modal-close" aria-label="Cerrar">✕</button>
              <h3 class="modal-titulo">{s.titulo}</h3>
              <div class="modal-secciones">
                {s.secciones.map(sec => (
                  <div class="req-seccion">
                    <h4 class="req-titulo">{sec.titulo}</h4>
                    <ol class="req-lista">
                      {sec.items.map(item => (
                        <li>{item}</li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )
      ))}

      <div class="ramo-cta">
        <p>¿Necesitas asesoría sobre alguno de estos trámites?</p>
        <a href={`${base}/contacto`} class="btn btn-primary">Agendar consulta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ramo-hero {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 7rem 0 4.5rem;
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-back {
    color: var(--color-gold-pale);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .ramo-back:hover {
    color: var(--color-white);
  }

  .ramo-hero :global(.section-subtitle) {
    color: var(--color-gold);
  }

  .ramo-hero h1 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: 0.04em;
    margin: 0.4rem 0 1.5rem;
  }

  .ramo-intro {
    max-width: 640px;
    color: rgba(255,255,255,0.78);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .ramo-section {
    background: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 300;
  }

  .ramo-subtitle {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-gold);
    display: inline-block;
    letter-spacing: 0.03em;
  }

  .ramo-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 820px;
    margin: 0 0 3.5rem;
    padding: 0;
  }

  /* Servicios simples (sin detalle) */
  .ramo-item-simple {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    padding: 1.1rem 1.5rem;
    color: var(--color-navy);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .ramo-item-clickable {
    cursor: pointer;
    transition: background 0.15s;
  }

  .ramo-item-clickable:hover {
    background: var(--color-cream);
  }

  .ramo-item-titulo {
    flex: 1;
  }

  .ramo-ver {
    font-size: 0.78rem;
    color: var(--color-gold);
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Modal */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(8,20,40,0.65);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(3px);
  }

  .modal-overlay.open {
    display: flex;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .modal-box {
    background: var(--color-white);
    border-top: 4px solid var(--color-gold);
    border-radius: 2px;
    padding: 2.5rem;
    max-width: 680px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    position: relative;
    animation: slideUp 0.25s ease;
  }

  @keyframes slideUp {
    from { transform: translateY(16px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    transition: color 0.15s;
  }

  .modal-close:hover { color: var(--color-navy); }

  .modal-titulo {
    font-family: var(--font-serif);
    color: var(--color-navy);
    font-size: 1.3rem;
    margin-bottom: 1.75rem;
    padding-right: 2rem;
    line-height: 1.3;
  }

  .modal-secciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .req-seccion {}

  .req-titulo {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(158,124,63,0.3);
  }

  .req-lista {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .req-lista li {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .ramo-bullet {
    color: var(--color-gold);
    font-size: 0.7rem;
    margin-top: 0.4rem;
    flex-shrink: 0;
  }

  .ramo-cta {
    background: var(--color-white);
    border-top: 3px solid var(--color-gold);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 820px;
  }

  .ramo-cta p {
    color: var(--color-text);
    font-size: 1rem;
    margin: 0;
  }

  .ramo-imagen {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    line-height: 0;
  }

  .ramo-imagen img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 700px) {
    .ramo-list {
      grid-template-columns: 1fr;
    }
    .ramo-cta {
      flex-direction: column;
      align-items: flex-start;
    }
    .ramo-imagen img {
      height: 260px;
    }
    .modal-secciones {
      grid-template-columns: 1fr;
    }
    .modal-box {
      padding: 1.75rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ramo-item-clickable').forEach(item => {
    item.addEventListener('click', () => {
      const id = item.dataset.modal!;
      document.getElementById(id)?.classList.add('open');
    });
  });

  document.querySelectorAll<HTMLElement>('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => {
      if (e.target === overlay) overlay.classList.remove('open');
    });
    overlay.querySelector('.modal-close')?.addEventListener('click', () => {
      overlay.classList.remove('open');
    });
  });
</script>
