---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bg = `${base}/images/huasteca3.jpg`;

const servicios = [
  {
    slug: 'inmobiliarios',
    titulo: 'Inmobiliarios',
    desc: 'Compraventa, donación, hipotecas y escrituración de propiedad con certeza jurídica plena.',
    icon: `<path d="M6 42h36"/><path d="M10 42V18l14-9 14 9v24"/><path d="M16 42V24h4v18M28 42V24h4v18"/><path d="M10 18h28"/>`,
  },
  {
    slug: 'mercantil-y-societario',
    titulo: 'Mercantil y Societario',
    desc: 'Constitución de sociedades, asambleas, fusiones, escisiones y reformas estatutarias.',
    icon: `<rect x="9" y="10" width="30" height="32"/><path d="M9 18h30M9 26h30M9 34h30"/><path d="M17 10v32M24 10v32M31 10v32"/>`,
  },
  {
    slug: 'patrimoniales-y-sucesorios',
    titulo: 'Patrimoniales y Sucesorios',
    desc: 'Testamentos, adjudicación por herencia y declaraciones patrimoniales con total discreción.',
    icon: `<path d="M14 6h16l8 8v28H14z"/><path d="M30 6v8h8"/><path d="M19 22h14M19 28h14M19 34h10"/>`,
  },
  {
    slug: 'familiares',
    titulo: 'Familiares',
    desc: 'Capitulaciones matrimoniales, convenios de divorcio y reconocimiento de hijos.',
    icon: `<circle cx="17" cy="16" r="5"/><circle cx="31" cy="16" r="5"/><path d="M8 38c0-5 4-9 9-9s9 4 9 9"/><path d="M22 38c0-5 4-9 9-9s9 4 9 9"/>`,
  },
  {
    slug: 'poderes',
    titulo: 'Poderes',
    desc: 'Poderes generales y especiales para pleitos, administración, dominio y revocaciones.',
    icon: `<path d="M30 8l10 10-22 22-10-10z"/><path d="M30 8l4-4 10 10-4 4"/><path d="M8 40l-2 2 8-2z"/><path d="M22 16l10 10"/>`,
  },
  {
    slug: 'fe-publica-y-certificaciones',
    titulo: 'Fe Pública y Certificaciones',
    desc: 'Fe de hechos, certificación de documentos, ratificación de firmas y avisos notariales.',
    icon: `<circle cx="24" cy="20" r="11"/><circle cx="24" cy="20" r="6"/><path d="M17 30l-3 12 10-5 10 5-3-12"/>`,
  },
];
---

<section class="section servicios-section" id="servicios" style={`background-image: url('${bg}')`}>
  <div class="container">
    <div class="servicios-header">
      <p class="section-subtitle">Lo que hacemos</p>
      <h2 class="section-title">Servicios Notariales</h2>
      <div class="section-divider"></div>
      <p class="servicios-intro">
        Cubrimos los principales ramos del derecho notarial. Selecciona un área para
        conocer el detalle de los trámites que ofrecemos.
      </p>
    </div>

    <div class="servicios-grid">
      {servicios.map(s => (
        <a class="servicio-card" href={`${base}/servicios/${s.slug}`}>
          <span class="servicio-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={s.icon}
            />
          </span>
          <h3 class="servicio-titulo">{s.titulo}</h3>
          <p class="servicio-desc">{s.desc}</p>
          <span class="servicio-link">Ver más <span class="arrow">→</span></span>
        </a>
      ))}
    </div>

    <div class="servicios-cta">
      <p>¿No encuentras el trámite que necesitas?</p>
      <a href={`${base}/contacto`} class="btn btn-primary">Contáctanos</a>
    </div>
  </div>
</section>

<style>
  .servicios-section {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    font-family: var(--font-display);
    font-weight: 300;
    padding: 7rem 0;
  }

  .servicios-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 40, 0.28);
    z-index: 0;
    pointer-events: none;
  }

  .servicios-section .container {
    position: relative;
    z-index: 1;
  }

  .servicios-header {
    max-width: 580px;
    margin-bottom: 3rem;
  }

  .servicios-header :global(.section-subtitle) {
    color: var(--color-gold-pale);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
  }

  .servicios-intro {
    color: #ffffff;
    font-size: 1rem;
    line-height: 1.8;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .servicio-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.20);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-top: 3px solid var(--color-gold);
    padding: 2.25rem 1.75rem 2rem;
    border-radius: 2px;
    text-decoration: none;
    color: inherit;
    transition: background 0.25s, box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  }

  .servicio-card:hover {
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 14px 32px rgba(13,27,46,0.22);
    transform: translateY(-4px);
  }

  .servicio-icon {
    color: var(--color-gold);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .servicio-icon svg {
    width: 100%;
    height: 100%;
  }

  .servicio-titulo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: #050d1a;
    margin-bottom: 0.6rem;
  }

  .servicio-desc {
    color: #ffffff;
    font-size: 0.88rem;
    line-height: 1.65;
    flex: 1;
    margin-bottom: 1.25rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }

  .servicio-link {
    color: var(--color-gold);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s;
  }

  .servicio-link .arrow {
    transition: transform 0.25s;
  }

  .servicio-card:hover .servicio-link {
    color: var(--color-navy);
  }

  .servicio-card:hover .servicio-link .arrow {
    transform: translateX(4px);
  }

  .servicios-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .servicios-cta p {
    color: #ffffff;
    font-size: 1rem;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
  }

  @media (max-width: 900px) {
    .servicios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .servicios-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
