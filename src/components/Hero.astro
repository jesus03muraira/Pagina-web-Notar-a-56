---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <div class="slides-track">
    <!-- Slide 1: Foto.fachada.jpg con título -->
    <div class="slide slide-1" style={`background-image: url('${base}/images/Foto.fachada.jpg')`}>
      <div class="slide-overlay"></div>
      <div class="hero-title-wrap">
        <span class="hero-line"></span>
        <h1 class="hero-title">Notaría Pública 56</h1>
        <span class="hero-line"></span>
      </div>
    </div>

    <!-- Slide 2: legado.jpg sin título -->
    <div class="slide slide-2" style={`background-image: url('${base}/images/legado.jpg')`}>
      <div class="slide-overlay"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .slides-track {
    display: flex;
    width: 200%;
    height: 100%;
    min-height: 100vh;
    transition: transform 1s cubic-bezier(0.77, 0, 0.18, 1);
  }

  .slides-track.slide-to-2 {
    transform: translateX(-50%);
  }

  .slide {
    position: relative;
    width: 50%;
    min-height: 100vh;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .slide-1 {
  }

  .slide-2 {
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 40, 0.52);
    z-index: 0;
  }

  .hero-title-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 90%;
  }

  .hero-line {
    flex: 1;
    height: 1px;
    background: rgba(242, 234, 216, 0.55);
    min-width: 2rem;
    max-width: 6rem;
  }

  .hero-title {
    font-family: 'Montserrat', 'Helvetica Neue', sans-serif;
    font-weight: 300;
    font-size: clamp(1.2rem, 2.8vw, 2.1rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #f2ead8;
    text-align: center;
    line-height: 1.4;
    margin: 0;
    padding-left: 0.32em;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .hero, .slide { min-height: 90vh; }
    .hero-line { max-width: 2rem; }
    .hero-title {
      font-size: clamp(0.75rem, 3.2vw, 1rem);
      letter-spacing: 0.25em;
    }
  }
</style>

<script>
  const track = document.querySelector('.slides-track') as HTMLElement;
  let current = 0;
  const total = 2;
  const INTERVAL = 5000;

  function next() {
    current = (current + 1) % total;
    if (current === 1) {
      track.classList.add('slide-to-2');
    } else {
      track.classList.remove('slide-to-2');
    }
  }

  setInterval(next, INTERVAL);
</script>
