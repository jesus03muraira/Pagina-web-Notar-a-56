---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroBg = `${base}/images/fachada.jpg`;
---

<section
  class="hero"
  style={`background-image: linear-gradient(135deg, rgba(6,14,26,0.88) 0%, rgba(13,27,46,0.82) 55%, rgba(6,14,26,0.92) 100%), url('${heroBg}')`}
>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <p class="hero-eyebrow">Fe Pública y Confianza</p>
    <h1 class="hero-title">Notaría Pública<br /><span class="hero-title-accent">No. 56</span></h1>
    <p class="hero-notario">Lic. Sergio de Jesús Gil Valdez</p>
    <p class="hero-desc">
      Más de dos décadas brindando seguridad jurídica a personas y empresas.
      Atención personalizada, trámites ágiles y asesoría legal de primer nivel.
    </p>
    <div class="hero-actions">
      <a href={`${base}/contacto`} class="btn btn-primary">Agendar cita</a>
      <a href={`${base}/#servicios`} class="btn btn-outline">Ver servicios</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">+25</span>
        <span class="stat-label">Años de experiencia</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">+10,000</span>
        <span class="stat-label">Escrituras firmadas</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">100%</span>
        <span class="stat-label">Respaldo legal</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    background-color: var(--color-navy-dark);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 48px,
      rgba(158, 124, 63, 0.025) 48px,
      rgba(158, 124, 63, 0.025) 49px
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 4rem;
    padding-bottom: 4rem;
    max-width: 680px;
  }

  .hero-eyebrow {
    color: var(--color-gold);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    color: var(--color-white);
    line-height: 1.12;
    margin-bottom: 0.6rem;
  }

  .hero-title-accent {
    color: var(--color-gold);
  }

  .hero-notario {
    color: rgba(255,255,255,0.55);
    font-size: 0.9rem;
    font-style: italic;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
  }

  .hero-desc {
    color: rgba(255,255,255,0.75);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2.25rem;
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
  }

  .stat-label {
    color: rgba(255,255,255,0.5);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    margin-top: 0.25rem;
  }

  .stat-divider {
    width: 1px;
    height: 2.5rem;
    background: rgba(158,124,63,0.3);
  }

  @media (max-width: 600px) {
    .hero { min-height: 75vh; }
    .stat-divider { display: none; }
    .hero-stats { gap: 1.5rem 2rem; }
  }
</style>
