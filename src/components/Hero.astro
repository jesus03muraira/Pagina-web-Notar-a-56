---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroBg = `${base}/images/Foto.fachada.jpg`;
---

<section class="hero" style={`background-image: url('${heroBg}')`}>
  <div class="hero-title-wrap">
    <span class="hero-line"></span>
    <h1 class="hero-title">Notaría Pública 56</h1>
    <span class="hero-line"></span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .hero-title-wrap {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 90%;
  }

  .hero-line {
    flex: 1;
    height: 1px;
    background: rgba(242, 234, 216, 0.55);
    min-width: 2rem;
    max-width: 6rem;
  }

  .hero-title {
    font-family: 'Montserrat', 'Helvetica Neue', sans-serif;
    font-weight: 300;
    font-size: clamp(1.2rem, 2.8vw, 2.1rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #f2ead8;
    text-align: center;
    line-height: 1.4;
    margin: 0;
    padding-left: 0.32em;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 90vh;
    }
    .hero-line {
      max-width: 2rem;
    }
    .hero-title {
      font-size: clamp(0.75rem, 3.2vw, 1rem);
      letter-spacing: 0.25em;
    }
  }
</style>
