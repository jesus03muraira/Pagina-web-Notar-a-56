---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <!-- 3 slots: S1 → S2 → S1_clone  (siempre hacia la izquierda) -->
  <div class="slides-track" id="heroTrack">
    <!-- Slot 1: Foto.fachada.jpg con título -->
    <div class="slide" style={`background-image: url('${base}/images/Foto.fachada.jpg')`}>
      <div class="slide-overlay"></div>
      <div class="hero-title-wrap">
        <span class="hero-line"></span>
        <h1 class="hero-title">Notaría Pública 56</h1>
        <span class="hero-line"></span>
      </div>
    </div>

    <!-- Slot 2: legado2.jpg sin título -->
    <div class="slide slide-legado" style={`background-image: url('${base}/images/legado2.jpg')`}>
      <div class="slide-overlay"></div>
    </div>

    <!-- Slot 3: clon de Slot 1 (para que el loop sea siempre a la izquierda) -->
    <div class="slide" style={`background-image: url('${base}/images/Foto.fachada.jpg')`}>
      <div class="slide-overlay"></div>
      <div class="hero-title-wrap">
        <span class="hero-line"></span>
        <span class="hero-title">Notaría Pública 56</span>
        <span class="hero-line"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 70vw ≈ ratio de legado2.jpg (1.43:1) en pantallas anchas, 115vh mínimo en pantallas altas */
    min-height: max(115vh, 70vw);
    overflow: hidden;
  }

  .slides-track {
    display: flex;
    width: 300%;
    min-height: max(115vh, 70vw);
    /* transición manejada por JS; sin transition aquí al inicio */
  }

  .slide {
    position: relative;
    width: 33.3333%;
    min-height: max(115vh, 70vw);
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .slide-legado {
    background-position: center center;
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 40, 0.52);
    z-index: 0;
  }

  .hero-title-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 90%;
  }

  .hero-line {
    flex: 1;
    height: 1px;
    background: rgba(242, 234, 216, 0.55);
    min-width: 2rem;
    max-width: 6rem;
  }

  .hero-title {
    font-family: 'Montserrat', 'Helvetica Neue', sans-serif;
    font-weight: 300;
    font-size: clamp(1.2rem, 2.8vw, 2.1rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #f2ead8;
    text-align: center;
    line-height: 1.4;
    margin: 0;
    padding-left: 0.32em;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .hero, .slides-track, .slide { min-height: 100svh; }
    .hero-line { max-width: 2rem; }
    .hero-title {
      font-size: clamp(0.75rem, 3.2vw, 1rem);
      letter-spacing: 0.25em;
    }
  }
</style>

<script>
  const track = document.getElementById('heroTrack') as HTMLElement;
  const SLIDE_W = 100 / 3; // 33.33% — cada slot ocupa 1/3 del track
  const INTERVAL = 5000;
  const DURATION = 1000; // ms de la transición

  let current = 0; // índice real del slot visible (0 o 1)

  function goTo(index: number, animate: boolean) {
    track.style.transition = animate
      ? `transform ${DURATION}ms cubic-bezier(0.77, 0, 0.18, 1)`
      : 'none';
    track.style.transform = `translateX(-${SLIDE_W * index}%)`;
  }

  function advance() {
    if (current === 0) {
      // S1 → S2
      current = 1;
      goTo(1, true);
    } else {
      // S2 → S1_clone (slot 2, index 2)
      goTo(2, true);
      // Al terminar la animación, saltar sin transición a S1 real (index 0)
      setTimeout(() => {
        goTo(0, false);
        current = 0;
      }, DURATION + 50);
    }
  }

  setInterval(advance, INTERVAL);
</script>
