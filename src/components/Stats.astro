---
---

<section class="stats-strip">
  <div class="stats-inner">
    <div class="stat-item reveal" style="--delay: 0s">
      <span class="stat-num">+15</span>
      <span class="stat-label">Años de<br/>experiencia</span>
    </div>
    <span class="stat-divider"></span>
    <div class="stat-item reveal" style="--delay: 0.12s">
      <span class="stat-num" id="counter-escrituras">+0</span>
      <span class="stat-label">Escrituras<br/>firmadas</span>
    </div>
    <span class="stat-divider"></span>
    <div class="stat-item reveal" style="--delay: 0.24s">
      <span class="stat-num">100%</span>
      <span class="stat-label">Respaldo<br/>legal</span>
    </div>
  </div>
</section>

<style>
  .stats-strip {
    background: linear-gradient(135deg, #6b5128 0%, #7d6035 45%, #5c4522 100%);
    padding: 4.5rem 2rem;
    font-family: var(--font-display);
    position: relative;
    overflow: hidden;
  }

  .stats-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255,255,255,0.06) 0%, transparent 50%),
      radial-gradient(120% 140% at 100% 100%, rgba(0,0,0,0.20) 0%, transparent 55%);
    pointer-events: none;
  }

  .stats-inner {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .stat-num {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 12px rgba(0,0,0,0.18);
  }

  .stat-label {
    color: rgba(255, 230, 180, 0.6);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.6;
  }

  .stat-divider {
    width: 1px;
    align-self: stretch;
    min-height: 90px;
    background: rgba(255, 255, 255, 0.28);
    flex-shrink: 0;
  }

  /* ── Animaciones reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }

  @media (max-width: 600px) {
    .stats-inner {
      flex-direction: column;
      gap: 2.5rem;
    }
    .stat-divider {
      width: 60%;
      min-height: 0;
      height: 1px;
    }
  }
</style>

<script>
  const revealEls = document.querySelectorAll('.stats-strip .reveal');
  const revealObserver = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );
  revealEls.forEach(el => revealObserver.observe(el));

  // Contador de escrituras
  const el = document.getElementById('counter-escrituras');
  if (el) {
    const target = 1000;
    const duration = 3000;
    let started = false;

    const run = () => {
      if (started) return;
      started = true;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        const value = Math.floor(eased * target);
        el.textContent = `+${value.toLocaleString('es-MX')}`;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = '+1,000';
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      entries => { if (entries[0].isIntersecting) run(); },
      { threshold: 0.4 }
    );
    observer.observe(el);
  }
</script>
